{
  "name": "@aec-craft/ui",
  "version": "0.8.0",
  "description": "buildOS design system. shadcn (base-ui) primitives, blocks, custom components + branding, one shared frosted-glass material. Ships TS/TSX source; consumers compile via their own Tailwind + bundler.",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aec-craft/ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=22.10.0"
  },
  "packageManager": "pnpm@10.4.1",
  "files": [
    "components",
    "hooks",
    "lib",
    "styles",
    "fonts.ts",
    "icons.ts",
    "postcss.config.mjs",
    "components.json",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "clean": "rm -rf .tsbuildinfo",
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "ui:add": "shadcn add",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "exports": {
    "./globals.css": "./styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./fonts": "./fonts.ts",
    "./icons": "./icons.ts",
    "./lib/*": "./lib/*.ts",
    "./hooks/*": "./hooks/*.ts",
    "./components/primitives/*": "./components/primitives/*.tsx",
    "./components/blocks/*": "./components/blocks/*.tsx",
    "./components/custom/*": "./components/custom/*.tsx",
    "./components/branding/*": "./components/branding/*.tsx"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "next": "^15 || ^16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@changesets/cli": "^2.27.10",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "ultracite": "7.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
